# Build output. The upstream tree carries no .gitignore, and DANOS builds in
# place, so the artefacts land beside the source.
/debian/files
/debian/tmp/
/debian/.debhelper/
/debian/*.substvars
/debian/*.debhelper.log
/debian/*.debhelper
/debian/vyatta-service-ssh/
/debian/vyatta-service-ssh-v1-yang/
/debian/vyatta-service-ssh-routing-instance-v1-yang/
/.pc/
